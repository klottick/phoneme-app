    "lessons": [
      {
        "id": "en-fr-vowels",
        "title": "Keep French vowels steady",
        "explanation": "English vowels often glide. In French, hold one steady mouth position. Compare lit /i/ and beau /o/: avoid adding an English-style “y” or “w” at the end. English comparisons are starting points, not exact equivalents.",
        "sounds": ["i", "o"],
        "words": ["lit", "beau", "vite", "mot"]
      },
      {
        "id": "en-fr-u-y",
        "title": "Tu or tout?",
        "explanation": "French /u/ in tout is close to the vowel in English “food”, but keep it steady. For /y/ in tu, hold your tongue as for /i/ and round your lips. English has no direct equivalent of /y/. French “ou” and “u” represent different sounds.",
        "sounds": ["u", "y"],
        "words": ["tout", "tu", "rouge", "rue", "vous", "lune"]
      },
      {
        "id": "en-fr-nasal",
        "title": "Let vowels resonate",
        "explanation": "Compare beau /bo/, bon /bɔ̃/ and banc /bɑ̃/. For nasal vowels, air passes through the nose as well as the mouth. Do not add an English /n/ at the end. The tilde marks a nasal vowel; these are different vowel sounds, not just different spellings.",
        "sounds": ["o", "ɔ̃", "ɑ̃"],
        "words": ["beau", "bon", "banc", "nom", "sans"]
      },
      {
        "id": "en-fr-r",
        "title": "Meet the French R",
        "explanation": "French /ʁ/ is made near the back of the mouth, unlike most English R sounds. Listen to rue and rouge; keep your tongue tip relaxed. French R varies by speaker—aim for comfortable, clear speech rather than forcing a harsh sound.",
        "sounds": ["ʁ", "u", "y"],
        "words": ["rue", "rouge", "mur"]
      },
      {
        "id": "en-fr-mix",
        "title": "Mix your new sounds",
        "explanation": "Listen first, then identify the vowel. Keep /u/ and /y/ distinct, hold vowels steady, and let nasal vowels resonate. Say the words and compare your recording with the reference.",
        "sounds": ["u", "y", "i", "o", "ɔ̃", "ɑ̃"],
        "words": ["tout", "tu", "lit", "beau", "bon", "banc"]
      }
    ]
